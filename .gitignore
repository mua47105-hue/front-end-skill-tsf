.DS_Store

# Screenshot output from the Playwright gauntlet
screenshots/

# Harness mirrors are generated by scripts/sync_harnesses.sh but are COMMITTED
# so a fresh clone or a plugin install discovers the skill with no setup step.
# They are byte-identical copies of skills/frontend-studio-gauntlet. Verify
# them with: bash scripts/sync_harnesses.sh --check
#
# Do not add .opencode/skills/, .agents/skills/, or .claude/skills/ here.

# Local run output
.playwright-gauntlet/
report.json
